{
  "name": "socheata-portfolio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run index:blog && next build && node scripts/generate-pwa.mjs && node scripts/package-runtime.mjs",
    "start": "node .next/standalone/server.js",
    "preview": "node scripts/preview.mjs",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:pwa": "node scripts/check-pwa.mjs",
    "test:pwa": "node --test scripts/pwa*.test.mjs",
    "test:blog": "node --import tsx --test scripts/blog-*.test.mjs",
    "index:blog": "node --import tsx scripts/generate-blog-index.ts",
    "check:server": "node scripts/check-server.mjs",
    "test:scale": "node --import tsx scripts/benchmark-blog.mts",
    "build:pages": "npm run index:blog && node scripts/build-pages.mjs",
    "check:pages": "node scripts/check-pages.mjs && node scripts/check-pwa.mjs out",
    "preview:pages": "node scripts/preview-pages.mjs"
  },
  "dependencies": {
    "image-size": "2.0.4",
    "minisearch": "^7.2.0",
    "next": "^16.4.1",
    "next-mdx-remote": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "vfile": "^6.0.3",
    "vfile-matter": "^5.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript/typescript6": "^6.0.2",
    "prettier": "3.9.10",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
